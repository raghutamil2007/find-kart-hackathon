# GEMINI_API_KEY: Required for Gemini AI shopping assistant chatbot.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key for signing session tokens (optional, auto-generated if omitted)
# SESSION_SECRET="your-secure-random-secret-key"

# DATABASE_URL: PostgreSQL Connection String
# Examples:
# Cloud PostgreSQL (Neon):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Cloud PostgreSQL (Supabase):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xyz.supabase.co:5432/postgres"
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findkart"
DATABASE_URL=""

# Kafka broker(s) — comma-separated (e.g. localhost:9092 or broker1:9092,broker2:9092)
KAFKA_BROKERS="localhost:9092"
