# ==========================================
# FindKart PostgreSQL Configuration Example
# Copy this file to .env and fill in your database credentials
# ==========================================

# OPTION 1: Cloud PostgreSQL (Aiven, Neon, Supabase, Render, Railway)
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@pg-host.aivencloud.com:10969/defaultdb?sslmode=require"

# OPTION 2: Local PostgreSQL Server
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findkart"

# Connection Pool Settings (Optional)
# PG_MAX_POOL=10
# DATABASE_SSL=false
